                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">if (prev.getURL().getPath() != '/course/view.php' || !prev.getResponseDataAsString().contains(props.getProperty('course_marker'))) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Private course assertion failed'); }</stringProp>
                </JSR223Assertion>
